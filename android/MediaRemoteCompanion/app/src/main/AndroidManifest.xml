<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11 and older -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Android 12+ : talk to an already-paired device (no scanning, no location) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Lets the app show Android's one-tap "let this app run in the background?" prompt -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- No INTERNET permission, on purpose: the app can't send anything anywhere except to the remote. -->

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Only so the screen can show the music app's name and icon ("via Spotify") -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Media Remote"
        android:theme="@style/Theme.MediaRemote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification access is what lets the app read "now playing" from any media app.
             The app never reads or stores your notifications themselves. -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:label="Media Remote"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
